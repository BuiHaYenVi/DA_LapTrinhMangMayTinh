# ============================================================
# DISCORD WEB CLONE — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the required secrets.
# NEVER commit .env or real secrets to version control!
# ============================================================

# 1. Neon PostgreSQL Serverless Database (Pooler URL recommended)
NEON_JDBC_URL=jdbc:postgresql://<ep-xxx-pooler>.neon.tech/<db>?sslmode=require
NEON_DB_USER=
NEON_DB_PASSWORD=
DB_POOL_MAX_SIZE=6

# 2. JWT Authentication (Stateless HMAC-SHA256)
JWT_SECRET=change-me-to-at-least-32-random-chars-secret-key
JWT_TTL_MINUTES=60

# 3. Multi-Protocol Network Ports (Local / Multi-Port Mode)
TCP_PORT=5000
UDP_PORT=5001
HTTP_PORT=8080
WS_PORT=8081

# 4. Single-Port Cloud Mode (Optional override for Render / Cloud PaaS)
# When PORT is set or SINGLE_PORT_MODE=true, HTTP + WebSocket share $PORT
# and UDP telemetry/signaling falls back over WebSocket/TCP.
PORT=
SINGLE_PORT_MODE=false

# 5. HTTP Gateway & Payload Guardrails
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=5
MESSAGE_MAX_CHARS=4000

# 6. WebRTC ICE / STUN / TURN Configuration
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USER=
TURN_PASSWORD=
