# ============================================================
# DISCORD WEB CLONE — FRONTEND (VITE + REACT) ENV TEMPLATE
# Copy this file to frontend/.env.local for local development
# ============================================================

# Backend HTTP REST API & WebSocket Gateway URLs
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8081

# Enable UDP Bridge telemetry & signaling metrics via Backend Gateway
VITE_UDP_BRIDGE_ENABLED=true

# WebRTC STUN / TURN ICE Servers for P2P Voice & Video
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASSWORD=
